#: src/display.c
#, c-format
msgid "pacpeek: monitor \"%s\" not found; available:"
msgstr "pacpeek: монитор «%s» не найден; доступные:"

#: src/main.c
msgid ""
"Usage: pacpeek [OPTION]...\n"
"Show the time, date and system status in a fullscreen overlay.\n"
"\n"
"  -m, --mode MODE        hold (default): close when a key is released\n"
"                         toggle: close when Esc is pressed\n"
"                         external: take no keyboard focus; close it from "
"outside (SIGTERM)\n"
"  -t, --timeout SECONDS  close automatically after SECONDS\n"
"  -M, --monitor NAME     show on monitor NAME (e.g. DP-1)\n"
"  -h, --help             show this help and exit\n"
"\n"
"Only one instance runs at a time; SIGTERM or SIGINT also close it.\n"
msgstr ""
"Использование: pacpeek [ПАРАМЕТР]...\n"
"Показывает время, дату и состояние системы в полноэкранном наложении.\n"
"\n"
"  -m, --mode РЕЖИМ       hold (по умолчанию): закрывается при отпускании "
"клавиши\n"
"                         toggle: закрывается по нажатию Esc\n"
"                         external: не берёт фокус клавиатуры; закрывается "
"извне (SIGTERM)\n"
"  -t, --timeout СЕКУНДЫ  закрывается автоматически через СЕКУНДЫ\n"
"  -M, --monitor ИМЯ      показывает на мониторе ИМЯ (например, DP-1)\n"
"  -h, --help             показывает эту справку и выходит\n"
"\n"
"Одновременно работает только один экземпляр; SIGTERM и SIGINT также "
"закрывают его.\n"

