#: src/display.c
#, c-format
msgid "pacpeek: monitor \"%s\" not found; available:"
msgstr "pacpeek: Monitor „%s“ nicht gefunden; verfügbar:"

#: src/main.c
msgid ""
"Usage: pacpeek [OPTION]...\n"
"Show the time, date and system status in a fullscreen overlay.\n"
"\n"
"  -m, --mode MODE        hold (default): close when a key is released\n"
"                         toggle: close when Esc is pressed\n"
"                         external: take no keyboard focus; close it from "
"outside (SIGTERM)\n"
"  -t, --timeout SECONDS  close automatically after SECONDS\n"
"  -M, --monitor NAME     show on monitor NAME (e.g. DP-1)\n"
"  -h, --help             show this help and exit\n"
"\n"
"Only one instance runs at a time; SIGTERM or SIGINT also close it.\n"
msgstr ""
"Verwendung: pacpeek [OPTION]...\n"
"Zeigt Uhrzeit, Datum und Systemstatus in einer Vollbild-Überlagerung an.\n"
"\n"
"  -m, --mode MODUS       hold (Standard): schließt beim Loslassen einer "
"Taste\n"
"                         toggle: schließt beim Drücken von Esc\n"
"                         external: nimmt keinen Tastaturfokus; von außen "
"schließen (SIGTERM)\n"
"  -t, --timeout SEKUNDEN schließt automatisch nach SEKUNDEN\n"
"  -M, --monitor NAME     zeigt auf dem Monitor NAME an (z. B. DP-1)\n"
"  -h, --help             zeigt diese Hilfe an und beendet\n"
"\n"
"Es läuft immer nur eine Instanz; SIGTERM oder SIGINT schließen sie "
"ebenfalls.\n"

