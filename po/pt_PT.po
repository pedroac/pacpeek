#: src/display.c
#, c-format
msgid "pacpeek: monitor \"%s\" not found; available:"
msgstr "pacpeek: monitor \"%s\" não encontrado; disponíveis:"

#: src/main.c
msgid ""
"Usage: pacpeek [OPTION]...\n"
"Show the time, date and system status in a fullscreen overlay.\n"
"\n"
"  -m, --mode MODE        hold (default): close when a key is released\n"
"                         toggle: close when Esc is pressed\n"
"                         external: take no keyboard focus; close it from "
"outside (SIGTERM)\n"
"  -t, --timeout SECONDS  close automatically after SECONDS\n"
"  -M, --monitor NAME     show on monitor NAME (e.g. DP-1)\n"
"  -h, --help             show this help and exit\n"
"\n"
"Only one instance runs at a time; SIGTERM or SIGINT also close it.\n"
msgstr ""
"Utilização: pacpeek [OPÇÃO]...\n"
"Mostra a hora, a data e o estado do sistema num ecrã sobreposto.\n"
"\n"
"  -m, --mode MODO        hold (predefinido): fecha ao largar uma tecla\n"
"                         toggle: fecha ao premir Esc\n"
"                         external: não toma o foco do teclado; fecha-se por "
"fora (SIGTERM)\n"
"  -t, --timeout SEGUNDOS fecha automaticamente após SEGUNDOS\n"
"  -M, --monitor NOME     mostra no monitor NOME (p. ex. DP-1)\n"
"  -h, --help             mostra esta ajuda e sai\n"
"\n"
"Só corre uma instância de cada vez; SIGTERM ou SIGINT também a fecham.\n"

