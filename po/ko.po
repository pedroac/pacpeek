#: src/display.c
#, c-format
msgid "pacpeek: monitor \"%s\" not found; available:"
msgstr "pacpeek: 모니터 \"%s\"을(를) 찾을 수 없습니다. 사용 가능:"

#: src/main.c
msgid ""
"Usage: pacpeek [OPTION]...\n"
"Show the time, date and system status in a fullscreen overlay.\n"
"\n"
"  -m, --mode MODE        hold (default): close when a key is released\n"
"                         toggle: close when Esc is pressed\n"
"                         external: take no keyboard focus; close it from "
"outside (SIGTERM)\n"
"  -t, --timeout SECONDS  close automatically after SECONDS\n"
"  -M, --monitor NAME     show on monitor NAME (e.g. DP-1)\n"
"  -h, --help             show this help and exit\n"
"\n"
"Only one instance runs at a time; SIGTERM or SIGINT also close it.\n"
msgstr ""
"사용법: pacpeek [옵션]...\n"
"시간, 날짜, 시스템 상태를 전체 화면 오버레이로 표시합니다.\n"
"\n"
"  -m, --mode 모드        hold (기본값): 키를 놓으면 닫습니다\n"
"                         toggle: Esc를 누르면 닫습니다\n"
"                         external: 키보드 포커스를 받지 않습니다. 외부에서 닫"
"아야 합니다 (SIGTERM)\n"
"  -t, --timeout 초       지정한 초 후에 자동으로 닫습니다\n"
"  -M, --monitor 이름     지정한 이름의 모니터에 표시합니다 (예: DP-1)\n"
"  -h, --help             이 도움말을 표시하고 종료합니다\n"
"\n"
"한 번에 하나의 인스턴스만 실행됩니다. SIGTERM 또는 SIGINT로도 닫을 수 있습니"
"다.\n"

#: src/main.c
#, c-format
msgid "pacpeek: invalid mode \"%s\" (use hold, toggle or external)\n"
msgstr ""
"pacpeek: 잘못된 모드 \"%s\" (hold, toggle 또는 external을 사용하세요)\n"

#: src/main.c
#, c-format
msgid "pacpeek: invalid timeout \"%s\" (seconds, 0 to %d)\n"
msgstr "pacpeek: 잘못된 제한 시간 \"%s\" (초, 0~%d)\n"

#: src/main.c
#, c-format
msgid "pacpeek: unexpected argument \"%s\"\n"
msgstr "pacpeek: 예상치 못한 인수 \"%s\"\n"

#: src/main.c
msgid ""
"pacpeek: could not create the overlay (needs wlr-layer-shell, wp_viewporter "
"and wp_single_pixel_buffer_v1)\n"
msgstr ""
"pacpeek: 오버레이를 만들 수 없습니다 (wlr-layer-shell, wp_viewporter, "
"wp_single_pixel_buffer_v1이 필요합니다)\n"

#: src/render.c
msgid "pacpeek: no font found; set PACPEEK_FONT to a .ttf/.otf file\n"
